  "states": [
    { "id": "overworld", "initial": true },
    { "id": "battle_active" },
    { "id": "battle_cleanup" }
  ],
  "transitions": [
    { "id": "battle-started", "from": "overworld", "to": "battle_active",
      "trigger": "screen.pushed" },
    { "id": "battle-ended", "from": "battle_active", "to": "battle_cleanup",
      "trigger": "battle.ended" },
    { "id": "battle-cleanup-complete", "from": "battle_cleanup", "to": "overworld",
      "trigger": "core.update" }
  ],
  "constraints": [
    {
      "id": "retain-pp-needs-swap-moves",
      "if": { "retainPP": true },
      "then": { "swapMoves": true }
    },
    {
      "id": "auto-catch-needs-auto-battle",
      "if": { "autoCatch": true },
      "then": { "autoBattle": true }
    },
    {
      "id": "auto-catch-options-need-auto-catch",
      "if": { "autoCatchNewOnly": true },
      "then": { "autoBattle": true, "autoCatch": true }
    },
    {
      "id": "catch-shiny-only-needs-auto-catch",
      "if": { "catchShinyOnly": true },
      "then": { "autoBattle": true, "autoCatch": true }
    },
    {
      "id": "auto-catch-target-needs-auto-catch",
      "if": { "autoCatchTarget": true },
      "then": { "autoBattle": true, "autoCatch": true }
    },
    {
      "id": "auto-catch-safety-needs-auto-battle",
      "if": { "autoStopLowHp": true },
      "then": { "autoBattle": true }
    },
    {
      "id": "auto-catch-pauses-need-auto-battle",
      "if": { "autoPauseNewEntry": true },
      "then": { "autoBattle": true }
    },
    {
      "id": "auto-catch-evolution-pause-needs-auto-battle",
      "if": { "autoPauseEvolution": true },
      "then": { "autoBattle": true }
    },
    {
      "id": "no-ball-stop-needs-auto-catch",
      "if": { "autoStopNoBalls": true },
      "then": { "autoBattle": true, "autoCatch": true }
    },
    {
      "id": "ball-counts-need-auto-catch",
      "if": { "showBallCounts": true },
      "then": { "autoBattle": true, "autoCatch": true }
    },
    {
      "id": "stop-on-target-needs-targeting",
      "if": { "autoStopTarget": true },
      "then": { "autoBattle": true, "autoCatch": true, "autoCatchTarget": true }
    },
    {
      "id": "auto-field-moves-need-field-moves",
      "if": { "fieldAbilitiesAuto": true },
      "then": { "fieldAbilities": true }
    },
    {
      "id": "party-ordering-needs-party-overview",
      "if": { "autoPartyOrder": true },
      "then": { "partyOverview": true }
    },
    {
      "id": "tracking-needs-minimap",
      "if": { "tracking": true },
      "then": { "minimap": true }
    },
    {
      "id": "tracker-filters-need-tracker",
      "if": { "encounterTrackerTracked": true },
      "then": { "encounterTracker": true }
    },
    {
      "id": "tracker-land-filter-needs-tracker",
      "if": { "encounterTrackerLand": true },
      "then": { "encounterTracker": true }
    },
    {
      "id": "tracker-surf-filter-needs-tracker",
      "if": { "encounterTrackerSurf": true },
      "then": { "encounterTracker": true }
    },
    {
      "id": "tracker-fishing-filter-needs-tracker",
      "if": { "encounterTrackerFishing": true },
      "then": { "encounterTracker": true }
    },
    {
      "id": "reset-name-needs-renaming",
      "if": { "restoreName": true },
      "then": { "renameAnywhere": true }
    },
    {
      "id": "trade-rename-needs-trade-renaming",
      "if": { "autoRenameTrades": true },
      "then": { "renameNpcTrades": true }
    }
  ],
